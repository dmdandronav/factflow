{
  "manifest_version": 3,
  "name": "FactFlow",
  "version": "1.0.0",
  "description": "Highlight any claim and learn how to verify it",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FactFlow"
  }
}
